@model TaskManager.Tasks.Dtos.TaskDto

@{
    ViewData["Title"] = "Chi tiết nhiệm vụ";
}

<h2 class="fw-bold text-primary mb-4">📋 Chi tiết nhiệm vụ</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="row">
            <!-- Bên trái: chi tiết -->
            <div class="col-md-8 border-end">
                <dl class="row">
                    <dt class="col-sm-4">📝 Tên nhiệm vụ</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4">📄 Mô tả</dt>
                    <dd class="col-sm-8">@Model.Description</dd>

                    <dt class="col-sm-4">👤 Người phụ trách</dt>
                    <dd class="col-sm-8">@Model.AssignedUserId</dd>

                    <dt class="col-sm-4">📌 Trạng thái</dt>
                    <dd class="col-sm-8">@Model.Status</dd>

                    <dt class="col-sm-4">📅 Ngày bắt đầu</dt>
                    <dd class="col-sm-8">@Model.StartDate.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-4">📅 Ngày kết thúc</dt>
                    <dd class="col-sm-8">@Model.EndDate.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-4">📁 Dự án</dt>
                    <dd class="col-sm-8">@Model.Project?.Name</dd>
                </dl>

                <div class="mt-4">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">✏️ Sửa</a>
                    <a asp-action="Index" class="btn btn-outline-secondary">⬅️ Quay lại Task</a>
                    <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.Project?.Id" class="btn btn-outline-secondary">⬅️ Quay lại Project</a>
                </div>
            </div>

            <div class="col-md-4">
                <h5 class="fw-bold">💬 Bình luận</h5>
                <div class="border p-2 mb-2" style="max-height:250px; overflow-y:auto;">
                    <div class="mb-2 border-bottom">
                        <strong>user1</strong>: Đây là comment mẫu
                    </div>
                    <div class="mb-2 border-bottom">
                        <strong>user2</strong>: Một comment khác...
                    </div>
                </div>
                <form asp-action="AddComment" method="post">
                    <input type="hidden" name="TaskId" value="@Model.Id" />
                    <div class="mb-2">
                        <textarea name="Content" class="form-control" placeholder="Nhập bình luận..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">Gửi</button>
                </form>
            </div>
        </div>
    </div>
</div>
